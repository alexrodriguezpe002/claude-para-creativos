{
  "description": "Registro de proyectos (MD FILES), respaldo diario a tu GitHub privado (skill respaldar) y sonido al terminar cada respuesta. Si falta Python o el sonido, no hacen nada.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/lanzar.sh\" post-tool; exit 0",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/lanzar.sh\" prompt; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/lanzar.sh\" sonido; exit 0",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/lanzar.sh\" stop; exit 0",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
